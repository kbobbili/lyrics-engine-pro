<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.kbobbili.xitelyrics"
    android:versionCode="1"
    android:versionName="0.1">

    <uses-sdk android:minSdkVersion="34" android:targetSdkVersion="34" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- adb-granted; lets PlaybackWatcher re-enable the accessibility service after a force-stop -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <queries>
        <package android:name="com.xite.musicvideos" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application android:label="XITE Lyrics" android:allowBackup="false">
        <service
            android:name=".LyricsAccessibilityService"
            android:exported="true"
            android:label="XITE Lyrics"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lyrics_service" />
        </service>

        <service
            android:name=".PlaybackWatcher"
            android:exported="true"
            android:label="XITE Lyrics playback"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />

        <!-- Exported so it can also be started by hand: am start -n dev.kbobbili.xitelyrics/.ProjectionActivity -->
        <activity
            android:name=".ProjectionActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
