<?xml version="1.0" encoding="utf-8"?>
<!-- Watches only XITE: reads its info panel. Also sees remote keys, and acts only on the
     TV-icon (lyrics on/off) and Star buttons, and only while XITE is in front. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:packageNames="com.xite.musicvideos"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewTextChanged|typeViewFocused"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagIncludeNotImportantViews|flagRetrieveInteractiveWindows|flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="200" />
